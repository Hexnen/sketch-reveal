<div class="sr-editor-root">
<div class="sr-editor-scroll">
  {{#unless sceneMode}}
  <fieldset>
    <legend>{{localize "SKETCHREVEAL.Section.Preset"}}</legend>
    <div class="form-group">
      <label>{{localize "SKETCHREVEAL.Field.Name"}}</label>
      <div class="form-fields"><input type="text" name="meta.name" value="{{meta.name}}"></div>
    </div>
    <div class="form-group">
      <label>{{localize "SKETCHREVEAL.Field.Kind"}}</label>
      <div class="form-fields">
        <select name="meta.kind">
          {{selectOptions kinds selected=meta.kind valueAttr="value" labelAttr="label"}}
        </select>
      </div>
      <p class="hint">{{localize "SKETCHREVEAL.Hint.Kind"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "SKETCHREVEAL.Field.Sketch"}}</label>
      <div class="form-fields"><file-picker name="meta.sketch" type="image" value="{{meta.sketch}}"></file-picker></div>
    </div>
    <div class="form-group">
      <label>{{localize "SKETCHREVEAL.Field.Painted"}}</label>
      <div class="form-fields"><file-picker name="meta.painted" type="image" value="{{meta.painted}}"></file-picker></div>
    </div>
  </fieldset>
  {{else}}
  <p class="notes">{{localize "SKETCHREVEAL.Editor.SceneNote"}}</p>
  {{/unless}}
  {{{configHtml}}}
</div>
<footer class="form-footer">
  <button type="button" data-action="preview"><i class="fa-solid fa-play"></i> {{localize "SKETCHREVEAL.Editor.Preview"}}</button>
  {{#if canOptimize}}<button type="button" data-action="optimizeImages" data-tooltip="SKETCHREVEAL.Optimize.Hint"><i class="fa-solid fa-compress"></i> {{localize "SKETCHREVEAL.Optimize.Button"}}</button>{{/if}}
  <button type="button" data-action="exportWebm"><i class="fa-solid fa-film"></i> {{localize "SKETCHREVEAL.Export.Button"}}</button>
  <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{saveLabel}}</button>
</footer>
</div>
